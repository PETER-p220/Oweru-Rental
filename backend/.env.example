APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://rental.oweru.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (in-app notifications always work; email needs real SMTP below) ──
# Local/dev: MAIL_MAILER=log writes emails to storage/logs/laravel.log only.
# Production: use smtp (cPanel, SendGrid, SES, etc.) so users receive email copies.
MAIL_MAILER=log
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# MAIL_SCHEME=null is only used by some Laravel mail URL configs; leave unset for typical SMTP.
MAIL_FROM_ADDRESS="noreply@oweru.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set true when MAIL_MAILER=smtp (not log). Sends email for NotificationService alerts.
MAIL_NOTIFICATIONS_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment (Oweru → Selcom checkout). Required for site visit, rent, and monthly payments.
# On production after editing these values, run: php artisan config:cache
OWERU_APP_KEY=your_selcom_app_key_here
# OWERU_CHECKOUT_URL=https://api.selcom.oweru.com/api/checkout
# Optional: only for first-month rent splits that pay Oweru share to a wallet. Site visit fees
# settle to Oweru via OWERU_APP_KEY; only the agent share is disbursed to users.phone.
# OWERU_ADMIN_PHONE=255712345678

# Site visit fee (TZS). Test: 200. Production example: 20000
SITE_VISIT_FEE=200
SITE_VISIT_OWERU_SHARE=0.5
SITE_VISIT_AGENT_SHARE=0.5

# Agent-listed rent split (fractions of tenant rent payment)
RENT_AGENT_SHARE=0.70
RENT_OWERU_SHARE=0.30

# Schedule rent reminders: add cron → * * * * * php /path/to/artisan schedule:run

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://rental.oweru.com/api/auth/google/callback
